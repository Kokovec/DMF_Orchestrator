# Renders the Ansible inventory consumed by the Host and Container Platform
# playbooks. Both infrastructure stacks use this so the hand-off is identical.
terraform {
  required_providers {
    local = { source = "hashicorp/local", version = "~> 2.5" }
  }
}

variable "path" {
  type = string
}

variable "hosts" {
  description = "name => { address, connection (local|ssh), user, role (server|agent), ptp_interface }"
  type = map(object({
    address       = string
    connection    = string
    user          = optional(string, "")
    role          = string
    ptp_interface = optional(string, "")
  }))
}

variable "vars" {
  type    = map(any)
  default = {}
}

locals {
  host_vars = { for name, h in var.hosts : name => merge(
    { ansible_host = h.address, ansible_connection = h.connection },
    h.user != "" ? { ansible_user = h.user } : {},
    h.ptp_interface != "" ? { dmf_ptp_interface = h.ptp_interface } : {},
  ) }
  inventory = {
    all = {
      vars = var.vars
      children = {
        dmf_cluster = {
          children = {
            k3s_server = { hosts = { for n, h in var.hosts : n => local.host_vars[n] if h.role == "server" } }
            k3s_agent  = { hosts = { for n, h in var.hosts : n => local.host_vars[n] if h.role == "agent" } }
          }
        }
      }
    }
  }
}

resource "local_file" "inventory" {
  filename        = var.path
  file_permission = "0640"
  content         = "# Generated by Terraform (infrastructure stack). Do not edit.\n${yamlencode(local.inventory)}"
}

output "path" {
  value = local_file.inventory.filename
}
